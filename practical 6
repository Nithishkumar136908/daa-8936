p = [10, 20, 30, 40]
n = 3

m = [[0 for j in range(4)] for i in range(4)]

for i in range(1, n + 1):
    m[i][i] = 0

for length in range(2, n + 1):
    for i in range(1, n - length + 2):
        j = i + length - 1

        k = i

        m[i][j] = m[i][k] + m[k + 1][j] + p[i - 1] * p[k] * p[j]

        if i == 1 and j == 3:
            print("A1 x A2 x A3")
            print("k = 1 :", m[i][j])

        for k in range(i + 1, j):
            cost = m[i][k] + m[k + 1][j] + p[i - 1] * p[k] * p[j]

            if i == 1 and j == 3:
                print("k =", k, ":", cost)

            if cost < m[i][j]:
                m[i][j] = cost

print()

print("m[1][2] (A1 x A2) =", m[1][2])
print("m[2][3] (A2 x A3) =", m[2][3])
print("m[1][3] (A1 x A2 x A3) =", m[1][3])

print()

print("Minimum value =", m[1][3])
